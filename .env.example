# Optional overrides — backupradar-mcp has no required env vars.
# Authentication is per-request via two headers:
#   X-BackupRadar-Api-Key   the Backup Radar API key (static, long-lived —
#                           this is NOT OAuth2; the vendor API itself expects
#                           a plain "ApiKey" header value).
#   X-BackupRadar-Site      which regional Backup Radar API to call:
#                           api.backupradar.com (US) or api-eu.backupradar.com (EU).

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
